# ==========================================
# Cortex Memory Engine Configuration
# ==========================================

# 1. Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
# Used for structured entity extraction and text embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Models (Optional - defaults to Gemini 2.0 Flash)
CORTEX_LLM_MODEL=gemini-2.0-flash
CORTEX_EMBED_MODEL=text-embedding-004

# 3. Storage directory (Optional - defaults to ~/.cortex_mem)
# CORTEX_DATA_DIR=/path/to/custom/storage
